<mujoco model="g1_tabletop_fixed">
  <!--
    Sprint 1.2 — Tabletop scene with fixed robot base (pelvis welded to world).
    Use this scene when you don't want the walker policy — robot pelvis is
    constrained in place via MuJoCo equality weld.
    Layout identical to ../scene.xml.
    Run.py still uses ../scene.xml (walker-based). This file is for the
    fixed-base data collection pipeline.
  -->

  <include file="../g1.xml"/>

  <statistic center="-0.1 0 0.8" extent="1.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="flat"
             rgb1="0.75 0.75 0.75" rgb2="0.7 0.7 0.7"
             mark="random" markrgb="0.72 0.72 0.72"
             width="512" height="512"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="8 8" reflectance="0.1"/>
    <material name="table_wood" rgba="0.55 0.35 0.2 1" specular="0.3" shininess="0.5"/>
  </asset>

  <!-- Weld pelvis to world — fixes robot base in place (Sprint 1.2) -->
  <!-- relpose: x y z qw qx qy qz (pelvis spawn: x=-0.6, z=0.76, identity quat) -->
  <equality>
    <weld name="pelvis_weld" body1="world" body2="pelvis"
          relpose="-0.6 0 0.76 1 0 0 0"
          solimp="0.999 0.9999 0.001" solref="0.004 1"/>
  </equality>

  <worldbody>
    <geom name="ground" type="plane" size="10 10 0.01" material="groundplane"
          contype="1" conaffinity="1"/>

    <light pos="0 0 4" dir="0 0 -1" diffuse="0.7 0.7 0.7" specular="0.3 0.3 0.3"
           castshadow="true"/>
    <light pos="-1 1 3" dir="0.3 -0.3 -1" diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1"/>

    <!-- Single table — near edge at x=-0.35, cubes within arm reach -->
    <body name="table" pos="0.0 0 0.713">
      <geom name="table_top" type="box" size="0.35 0.25 0.02" material="table_wood"
            contype="1" conaffinity="1" friction="1 0.1 0.01" mass="20"/>
      <geom name="table_leg_1" type="cylinder" size="0.025 0.345" pos=" 0.30  0.20 -0.365"
            rgba="0.4 0.25 0.15 1" contype="1" conaffinity="1" mass="1"/>
      <geom name="table_leg_2" type="cylinder" size="0.025 0.345" pos="-0.30  0.20 -0.365"
            rgba="0.4 0.25 0.15 1" contype="1" conaffinity="1" mass="1"/>
      <geom name="table_leg_3" type="cylinder" size="0.025 0.345" pos=" 0.30 -0.20 -0.365"
            rgba="0.4 0.25 0.15 1" contype="1" conaffinity="1" mass="1"/>
      <geom name="table_leg_4" type="cylinder" size="0.025 0.345" pos="-0.30 -0.20 -0.365"
            rgba="0.4 0.25 0.15 1" contype="1" conaffinity="1" mass="1"/>
    </body>

    <!-- Yellow open-top box container — left side (+Y) -->
    <body name="yellow_box" pos="-0.05 0.13 0.733">
      <geom name="ybox_floor" type="box" size="0.10 0.10 0.005"
            pos="0 0 0.005" rgba="0.95 0.85 0.0 1"
            contype="1" conaffinity="1" mass="0.5"/>
      <geom name="ybox_wall_px" type="box" size="0.005 0.105 0.025"
            pos=" 0.105 0 0.030" rgba="0.95 0.85 0.0 1"
            contype="1" conaffinity="1" mass="0.05"/>
      <geom name="ybox_wall_nx" type="box" size="0.005 0.105 0.025"
            pos="-0.105 0 0.030" rgba="0.95 0.85 0.0 1"
            contype="1" conaffinity="1" mass="0.05"/>
      <geom name="ybox_wall_py" type="box" size="0.105 0.005 0.025"
            pos="0  0.105 0.030" rgba="0.95 0.85 0.0 1"
            contype="1" conaffinity="1" mass="0.05"/>
      <geom name="ybox_wall_ny" type="box" size="0.105 0.005 0.025"
            pos="0 -0.105 0.030" rgba="0.95 0.85 0.0 1"
            contype="1" conaffinity="1" mass="0.05"/>
    </body>

    <!-- Red cube — right side (-Y), freejoint -->
    <body name="red_cube" pos="-0.10 -0.15 0.763">
      <freejoint name="red_cube_joint"/>
      <geom name="red_cube_geom" type="box" size="0.03 0.03 0.03"
            rgba="0.85 0.1 0.1 1" density="500"
            contype="1" conaffinity="1" friction="2 0.1 0.01"/>
    </body>

    <!-- Green cube — right side (-Y), freejoint -->
    <body name="green_cube" pos="-0.10 -0.22 0.763">
      <freejoint name="green_cube_joint"/>
      <geom name="green_cube_geom" type="box" size="0.03 0.03 0.03"
            rgba="0.1 0.75 0.1 1" density="500"
            contype="1" conaffinity="1" friction="2 0.1 0.01"/>
    </body>

    <!-- Scene cameras -->
    <camera name="overhead" pos="-0.1 0 2.0" xyaxes="1 0 0 0 1 0" fovy="65"/>
    <camera name="side_view" pos="1.0 -1.2 1.1" xyaxes="0.707 0.707 0 -0.2 0.2 0.96" fovy="55"/>
  </worldbody>
</mujoco>
